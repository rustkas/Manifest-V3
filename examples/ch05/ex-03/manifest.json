{
  "manifest_version": 3,
  "name": "Site Analyzer",
  "version": "1.0.0",
  "description": "Analyze example.com/articles, fetch api.example.com, save locally. Optional host for an additional site.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Site Analyzer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://example.com/*",
    "https://www.example.com/*",
    "https://api.example.com/*"
  ],
  "optional_host_permissions": [
    "https://*.wikipedia.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://example.com/articles/*",
        "https://www.example.com/articles/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}